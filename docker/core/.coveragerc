# Coverage configuration — measures unit-testable Python surface only.
#
# Files in `omit` require live infrastructure (DB pool, Qdrant, Redis, LM
# Studio, ComfyUI TTS, FastAPI runtime, WebSocket clients, OpenTelemetry
# collectors). Those are covered by the testcontainers integration suite
# (tests/integration/) and the perf-baseline workflow — measured separately.
#
# This separation is standard professional practice — pytest-cov + coverage.py
# explicitly support per-suite measurement via `omit`. Combined coverage
# (unit + integration) is the figure tracked against the S+ rubric ≥95% bar.

[run]
source = app
branch = True
omit =
    # Only non-runtime, one-off dev scripts are omitted now. Every module that
    # is part of the served app surface is MEASURED.
    #
    # Coverage-integrity fix (2026-05): this omit list previously excluded ~73%
    # of app/ (routes/chat/background/main/affection/memory/auth/llm_router/...),
    # which let a red suite still report "95.8% ✓" over a tiny surface. Those
    # modules now have real behavioral unit tests; true full-codebase coverage
    # is ~96%. Do NOT re-add app/ modules here to prop up the headline — the
    # audit caps this list and reports the true no-omit number alongside it.
    seed_memories.py
    reannotate_existing.py
    tools/*

[report]
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    if typing.TYPE_CHECKING:
    raise NotImplementedError
    raise AssertionError
    if __name__ == .__main__.:
    @(abc\.)?abstractmethod
    except Exception:.*pass
    raise$
    def __repr__
    def __str__
show_missing = True
skip_covered = False
precision = 1

[html]
directory = htmlcov
