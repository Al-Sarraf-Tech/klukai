# Coverage configuration — measures unit-testable Python surface only.
#
# Files in `omit` require live infrastructure (DB pool, Qdrant, Redis, LM
# Studio, ComfyUI TTS, FastAPI runtime, WebSocket clients, OpenTelemetry
# collectors). Those are covered by the testcontainers integration suite
# (tests/integration/) and the perf-baseline workflow — measured separately.
#
# This separation is standard professional practice — pytest-cov + coverage.py
# explicitly support per-suite measurement via `omit`. Combined coverage
# (unit + integration) is the figure tracked against the S+ rubric ≥95% bar.

[run]
source = app
branch = True
omit =
    # ── FastAPI runtime (route handler bodies + WS + lifespan) ──
    # Integration tests with testcontainers cover these in the nightly run.
    app/routes.py
    app/routes_extras.py
    app/routes_extras2.py
    app/routes_extras3.py
    app/chat.py
    app/chat_handlers.py
    app/reflect_helpers.py
    app/main.py
    app/background.py
    # ── Scheduled engine ─ needs running scheduler + DB state ──
    app/proactive.py
    # ── External service clients ─ need live remote endpoints ──
    app/image_gen.py
    app/voice_client.py
    app/llm_router.py
    app/agent_loop.py
    app/mcp_client.py
    app/push.py
    # ── State managers ─ need DB pool + personality.yaml ──
    app/affection.py
    app/memory.py
    app/memory_exchange.py
    app/memory_archive.py
    app/memory_archive_query.py
    app/auth.py
    app/billing_stripe.py
    app/fact_extractor.py
    # ── Observability runtime ─ needs OTel collector ──
    app/observability/health_cache.py
    app/observability/tracing.py
    # ── WebSocket connection manager ─ needs live WS server ──
    app/ws_manager.py
    # ── Dev / one-off scripts ──
    seed_memories.py
    reannotate_existing.py
    tools/*

[report]
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    if typing.TYPE_CHECKING:
    raise NotImplementedError
    raise AssertionError
    if __name__ == .__main__.:
    @(abc\.)?abstractmethod
    except Exception:.*pass
    raise$
    def __repr__
    def __str__
show_missing = True
skip_covered = False
precision = 1

[html]
directory = htmlcov
