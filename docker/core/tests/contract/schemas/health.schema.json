{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "cache",
    "database",
    "qdrant",
    "redis",
    "service",
    "status",
    "version"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "degraded",
        "down"
      ]
    },
    "service": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "database": {
      "type": "object"
    },
    "redis": {
      "type": "string"
    },
    "qdrant": {
      "type": "string"
    },
    "cache": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
