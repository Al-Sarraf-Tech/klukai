{
  "schema_version": 1,
  "limits": {"module_lines": 500, "complexity_mean": 10, "complexity_max": 20, "mutation_kill_rate": 0.8, "evidence_max_age_days": 30},
  "assertions": {
    "TEST-1": ["suite_passed", "coverage_at_least_95", "all_runtime_modules_measured", "skip_ceiling_75", "no_unexpected_warnings"],
    "TEST-2": ["unit_passed", "contract_passed", "property_passed", "golden_passed", "real_backend_integration_passed", "browser_journeys_passed", "performance_passed"],
    "SEC-2": ["image_high_critical_zero", "license_inventory_reviewed", "sbom_verified", "signature_verified", "source_materials_bound", "tool_inputs_pinned", "artifact_secret_scan_clean"],
    "SEC-3": ["encrypted_storage_active", "permissions_verified", "values_preserved", "rotation_and_recovery_tested", "missing_secret_fails_closed"],
    "REL-1": ["postgres_fail_closed", "redis_session_ownership_preserved", "qdrant_degrades", "model_breaker_recovery", "voice_text_degradation", "image_no_duplicate_or_unauthorized_fallback", "search_degrades"],
    "REL-2": ["dependency_chaos_passed", "half_open_recovery_passed", "cancellation_cleanup_passed", "readiness_passed", "shutdown_joins_before_database_close"],
    "REL-3": ["isolated_restore_integrity_passed", "automatic_code_rollback_passed", "runtime_settings_preserved", "newer_data_preserved"],
    "OBS-1": ["route_template_red_verified", "bounded_cardinality_verified", "sampled_correlated_traces_verified", "credential_redaction_verified"],
    "OBS-2": ["canonical_slos_verified", "actual_scrape_and_ingestion_verified", "burn_alert_routing_verified", "retention_verified", "dashboard_runbook_links_verified"],
    "PERF-1": ["bound_baseline_and_candidate", "comparable_conditions", "p99_delta_at_most_20_percent", "absolute_slos_passed", "missing_samples_fail_closed"],
    "PERF-2": ["nightly_samples_fresh", "source_bound", "retention_verified", "dashboard_visible"],
    "DOC-1": ["readme_architecture_current", "runbook_failure_taxonomy_current", "clean_onboarding_passed", "links_and_commands_verified", "owner_policies_preserved"],
    "PROC-1": ["protected_pr_verified", "independent_review_verified", "all_required_checks_passed", "no_required_gate_skipped", "self_hosted_runner_policy_verified"],
    "PROC-2": ["inputs_pinned", "isolated_build", "reproducibility_verified", "tested_artifact_digest_verified", "signed_manifest_verified", "no_deploy_rebuild"],
    "PROC-3": ["exact_ci_revision_verified", "live_image_and_pwa_digests_verified", "public_user_journeys_passed", "auth_revocation_and_isolation_passed", "provider_acceptance_passed"],
    "SPLUS.calendar": ["continuous_90_day_acceptance", "shared_core_libraries_100_percent", "historical_rotation_and_dr_evidence"]
  },
  "checks": [
    {"id":"CODE-1","dim":"code","name":"strict Python lint, format and types","kind":"python"},
    {"id":"CODE-2","dim":"code","name":"application module size and architecture","kind":"structure"},
    {"id":"CODE-3","dim":"code","name":"numeric cyclomatic complexity bounds","kind":"complexity"},
    {"id":"TEST-1","dim":"testing","name":"full served-surface coverage and clean suite","kind":"evidence"},
    {"id":"TEST-2","dim":"testing","name":"contract/property/golden/integration/browser/performance layers","kind":"evidence"},
    {"id":"TEST-3","dim":"testing","name":"fresh actual critical-path mutation results","kind":"mutation"},
    {"id":"SEC-1","dim":"security","name":"actual pinned distroless non-root final stage","kind":"image"},
    {"id":"SEC-2.secrets","dim":"security","name":"required gitleaks secret scan","kind":"secrets"},
    {"id":"SEC-2","dim":"security","name":"artifact SBOM, scans, licenses, signing and provenance","kind":"evidence"},
    {"id":"SEC-3","dim":"security","name":"encrypted production secret storage and recovery","kind":"evidence"},
    {"id":"REL-1","dim":"reliability","name":"actual per-dependency protection and safe degradation","kind":"evidence"},
    {"id":"REL-2","dim":"reliability","name":"dependency chaos, recovery and lifecycle","kind":"evidence"},
    {"id":"REL-3","dim":"reliability","name":"restored backup integrity and automatic code rollback","kind":"evidence"},
    {"id":"OBS-1","dim":"observability","name":"emitted bounded RED metrics and sampled traces","kind":"evidence"},
    {"id":"OBS-2","dim":"observability","name":"actual SLO, collection, retention and alert routing","kind":"evidence"},
    {"id":"PERF-1","dim":"performance","name":"comparable pre-merge p99 and absolute SLO gates","kind":"evidence"},
    {"id":"PERF-2","dim":"performance","name":"retained revision-bound nightly performance","kind":"evidence"},
    {"id":"DOC-1","dim":"documentation","name":"current docs, runbooks and clean onboarding","kind":"evidence"},
    {"id":"PROC-1","dim":"process","name":"protected reviewed PR and complete blocking CI","kind":"evidence"},
    {"id":"PROC-2","dim":"process","name":"reproducible build and immutable tested artifact","kind":"evidence"},
    {"id":"PROC-3","dim":"process","name":"exact tested revision and artifacts verified live","kind":"evidence"},
    {"id":"SPLUS.calendar","dim":"process","name":"S+ continuous dated acceptance and shared-library evidence","kind":"evidence","target":"S+"}
  ]
}
