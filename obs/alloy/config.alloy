// Alloy config — receives OTLP from companion-core, fans to Prom + Loki + Tempo.
//
// Per S+ uplift spec §5.2 — single collector pattern keeps the
// observability surface uniform: every klukai service talks one
// protocol (OTLP) to one endpoint (alloy:4317) and Alloy handles
// per-backend transport.

logging {
  level  = "info"
  format = "logfmt"
}

// ──────────────────────────────────────────────────────────────────
// OTLP ingest — companion-core points its OTel SDK here.
// ──────────────────────────────────────────────────────────────────

otelcol.receiver.otlp "klukai" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    metrics = [otelcol.processor.batch.klukai.input]
    logs    = [otelcol.processor.batch.klukai.input]
    traces  = [otelcol.processor.batch.klukai.input]
  }
}

otelcol.processor.batch "klukai" {
  send_batch_size     = 1024
  send_batch_max_size = 2048
  timeout             = "5s"

  output {
    metrics = [otelcol.exporter.prometheus.klukai.input]
    logs    = [otelcol.processor.transform.redact.input]
    traces  = [otelcol.exporter.otlp.tempo.input]
  }
}

// ──────────────────────────────────────────────────────────────────
// Log ingest-time redaction (Phase 2, ADR-0087-pending).
//
// Per ENTROPY_session_133 the
// service-side redaction in session-memory-mcp catches JSONL
// transcripts but not live log lines. This transform runs regex
// replacement against `body` for known credential shapes before
// the log is exported to Loki. Same pattern set as
// servers/session_memory_mcp/redactor.py so redaction lives in one
// conceptual place (just executed at two stages).
//
// Replacement marker: <redacted:KIND>. The original bytes are NOT
// retained — privacy > forensics for this use case. If a redacted
// log needs investigation, fall back to the service's own structured
// log (which already had its own redactor before emission).
//
// `error_mode = "ignore"` keeps the pipeline running on regex
// engine errors (very rare) so a malformed log line doesn't drop
// the batch.
// ──────────────────────────────────────────────────────────────────

otelcol.processor.transform "redact" {
  error_mode = "ignore"

  log_statements {
    context = "log"
    statements = [
      `replace_all_patterns(body, "value", "AKIA[0-9A-Z]{16}", "<redacted:aws-access-key>")`,
      `replace_all_patterns(body, "value", "ASIA[0-9A-Z]{16}", "<redacted:aws-session-key>")`,
      `replace_all_patterns(body, "value", "ghp_[A-Za-z0-9]{36}", "<redacted:github-pat>")`,
      `replace_all_patterns(body, "value", "gho_[A-Za-z0-9]{36}", "<redacted:github-oauth>")`,
      `replace_all_patterns(body, "value", "ghs_[A-Za-z0-9]{36}", "<redacted:github-server>")`,
      `replace_all_patterns(body, "value", "ghu_[A-Za-z0-9]{36}", "<redacted:github-user>")`,
      `replace_all_patterns(body, "value", "mk_[a-z0-9]+_[A-Za-z0-9_-]{16,}", "<redacted:mcp-bearer>")`,
      `replace_all_patterns(body, "value", "ey[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}", "<redacted:jwt>")`,
      `replace_all_patterns(body, "value", "-----BEGIN [A-Z ]+PRIVATE KEY-----[\\s\\S]+?-----END [A-Z ]+PRIVATE KEY-----", "<redacted:pem-private-key>")`,
    ]
  }

  output {
    logs = [otelcol.exporter.loki.klukai.input]
  }
}

// ──────────────────────────────────────────────────────────────────
// Metrics → Prometheus (remote_write).
// ──────────────────────────────────────────────────────────────────

otelcol.exporter.prometheus "klukai" {
  forward_to = [prometheus.remote_write.klukai.receiver]
}

prometheus.remote_write "klukai" {
  endpoint {
    url = "http://klukai-prometheus:9090/api/v1/write"
  }
}

// ──────────────────────────────────────────────────────────────────
// Logs → Loki.
// ──────────────────────────────────────────────────────────────────

otelcol.exporter.loki "klukai" {
  forward_to = [loki.write.klukai.receiver]
}

loki.write "klukai" {
  endpoint {
    url = "http://klukai-loki:3100/loki/api/v1/push"
  }
}

// ──────────────────────────────────────────────────────────────────
// Traces → Tempo.
// ──────────────────────────────────────────────────────────────────

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "klukai-tempo:4317"
    tls {
      insecure = true
    }
  }
}
