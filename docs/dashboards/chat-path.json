{
  "annotations": {"list": []},
  "description": "Klukai chat-path performance.",
  "title": "Klukai Chat Path",
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "/api/chat/turn p50/p95/p99",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{route=\"/api/chat/turn\"}[5m])))", "refId": "A", "legendFormat": "p50"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{route=\"/api/chat/turn\"}[5m])))", "refId": "B", "legendFormat": "p95"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{route=\"/api/chat/turn\"}[5m])))", "refId": "C", "legendFormat": "p99"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "title": "Time to first token (TTFT)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(klukai_chat_ttft_seconds_bucket[5m])))", "refId": "A", "legendFormat": "TTFT p99"}],
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "id": 3,
      "title": "Model routing (gemma / dolphin / gpt-oss)",
      "type": "piechart",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (model) (increase(klukai_llm_calls_total[1h]))", "refId": "A"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["klukai", "chat", "S+"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "uid": "klukai-chat-path",
  "version": 1
}
