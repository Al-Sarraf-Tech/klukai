[Unit]
Description=Klukai memory archive seed pass (bounded local window, no Dominus)
Documentation=file:///home/jalsarraf/git/klukai/ops/amarillo/README.md
After=docker.service network-online.target
Wants=network-online.target
ConditionPathIsDirectory=/home/jalsarraf/git/klukai

[Service]
Type=oneshot
WorkingDirectory=/home/jalsarraf/git/klukai
Environment=TZ=America/Chicago
UMask=0077
ExecCondition=/home/jalsarraf/.local/bin/klukai-memory-seed-day-condition
# Compose run by hand cannot interpolate this stack (its secrets are only in the
# encrypted store, so interpolation fails); exec straight into the running
# core container, which already has its whole environment.
ExecStartPre=/usr/bin/docker inspect -f '{{.State.Running}}' companion-core
# Dominus-free (owner order 2026-10-19): with KLUKAI_IMAGE_PROVIDER=agy the
# seeder selects/annotates through the background text helper and renders
# through the account worker. It does nothing unless core's environment sets
# KLUKAI_ALBUM_SEED_RENDERS to 1 or 2 (renders per run and per local day; the
# seeder never draws more than 2). This unit deliberately does not override
# that switch. The legacy Dominus LLM + ComfyUI path runs only with the
# explicit KLUKAI_IMAGE_PROVIDER=comfyui.
# Three nested bounds, all inside the 03:00-06:00 window of a 04:00 start:
#   SEED_DEADLINE_SECONDS=6000  the seeder stops itself before its next unit of
#                               work (05:40) and leaves last_seeded_at untouched
#   SEED_HARD_KILL_SECONDS=6600 SIGALRM ends the seeder INSIDE the container at
#                               05:50 (the distroless image has no `timeout`).
#                               TimeoutStartSec alone only kills the compose
#                               client; the seeder kept running.
#   TimeoutStartSec=6900        outer bound on the unit itself (05:55)
ExecStart=/usr/bin/docker exec -e SEED_DEADLINE_SECONDS=6000 -e SEED_HARD_KILL_SECONDS=6600 companion-core python3 /app/seed_memories.py
TimeoutStartSec=6900
Nice=10
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal
