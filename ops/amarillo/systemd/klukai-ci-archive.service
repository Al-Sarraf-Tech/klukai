[Unit]
Description=Move old Klukai CI records off the heavy guest into /docker/klukai/ci-records
After=network-online.target

[Service]
Type=oneshot
UMask=0077
WorkingDirectory=%h/git/klukai
Environment=HOME=%h
# Amarillo's own CI VMs write /docker/klukai/ci-artifacts (ops/amarillo/ci-runner).
ExecStart=/usr/bin/python3 %h/git/klukai/ops/amarillo/scripts/klukai-fetch-ci-artifacts.py --source amarillo archive
TimeoutStartSec=45min
Nice=10
IOSchedulingClass=idle
