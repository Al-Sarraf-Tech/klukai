[Unit]
Description=Klukai Alertmanager to bus bridge (owner notes)
After=default.target docker.service

[Service]
Type=simple
UMask=0077
WorkingDirectory=%h/git/klukai
Environment=HOME=%h
# Listens only on the klukai-obs Docker network gateway; Alertmanager posts here
# with the bearer token the system unit klukai-runtime-secrets.service decrypts at
# boot into /run (0400). If it is missing the bridge exits and Restart= retries.
ExecStart=/usr/bin/python3 %h/git/klukai/ops/amarillo/scripts/klukai-alert-bridge.py --bind 192.168.128.1:19095 --token-file /run/klukai-secrets/alert-bridge/alert-bridge-token --bus %h/.local/bin/bus --target owner@amarillo --project klukai
Restart=on-failure
RestartSec=10
TimeoutStopSec=10

[Install]
WantedBy=default.target
