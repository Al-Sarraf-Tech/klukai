# SYSTEM unit (/etc/systemd/system), not a user unit: at boot Docker restarts
# companion-core, Prometheus and Alertmanager before any user session exists, so
# their bearer tokens must be on /run first. It runs as the owner's user, because
# the credentials are user-scoped systemd-creds (system LoadCredentialEncrypted=
# cannot decrypt those), and it never runs code as root.
# Install and checks: docs/runbooks/encrypted-credentials.md ("Runtime tokens").
[Unit]
Description=Klukai runtime tokens: decrypt into /run/klukai-secrets before Docker
Documentation=file:///home/jalsarraf/git/klukai/docs/runbooks/encrypted-credentials.md
# Ordering only: Docker must still start (other stacks) if this fails; the
# Klukai consumers then refuse to start or answer 401 instead of using no token.
Before=docker.service
Wants=tpm2.target
After=tpm2.target
RequiresMountsFor=/home/jalsarraf/git/klukai /home/jalsarraf/.config/klukai/credentials

[Service]
Type=oneshot
RemainAfterExit=yes
User=jalsarraf
Group=jalsarraf
UMask=0077
RuntimeDirectory=klukai-secrets klukai-secrets/metrics klukai-secrets/alert-bridge
RuntimeDirectoryMode=0700
# Keep the directories on stop: containers bind-mount them, and a new directory
# would not be visible inside a running container. ExecStop removes the files.
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/python3 -I /home/jalsarraf/git/klukai/ops/amarillo/scripts/klukai_runtime_tokens.py install
ExecStop=/usr/bin/python3 -I /home/jalsarraf/git/klukai/ops/amarillo/scripts/klukai_runtime_tokens.py remove
TimeoutStartSec=120
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
# systemd-creds --user decrypts through the io.systemd.Credentials varlink socket.
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
