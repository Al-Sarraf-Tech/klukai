[Unit]
Description=Pull Klukai nightly CI evidence from the isolated heavy guest
After=network-online.target

[Service]
Type=oneshot
UMask=0077
WorkingDirectory=%h/git/klukai
Environment=HOME=%h
# Nightly runs on amarillo's own CI VMs since 2026-10-19 (ops/amarillo/ci-runner).
ExecStart=/usr/bin/python3 %h/git/klukai/ops/amarillo/scripts/klukai-fetch-ci-artifacts.py --source amarillo nightly --warn-after-days 3
TimeoutStartSec=15min
