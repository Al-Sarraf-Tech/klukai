# Copy to /mnt/nvmer0/services/ai-stack/config/stack.env on dominus-nobara.
# Keep that deployed file mode 0600. Never commit real tokens or private keys.
LLAMA_HTTP_THREADS=8
SPEACHES_STT_MODEL_TTL_SECONDS=600
SPEACHES_TTS_MODEL_TTL_SECONDS=600
VOICE_MODEL_TTL_SECONDS=600
HF_CACHE_MATERIALIZE_WORKERS=8

# Generate fresh values at cutover. Do not recover or reuse tokens from logs.
LM_STUDIO_TOKEN=
SPEACHES_API_KEY=
VOICE_API_TOKEN=
HUGGINGFACE_TOKEN=

TRANSCRIPTION_LOG_LEVEL=INFO
TRANSCRIPTION_BOOTSTRAP_TIMEOUT_SECONDS=1800
TRANSCRIPTION_INSTALL_WHISPER=true
TRANSCRIPTION_INSTALL_NEMO=true
MAIN_TRANSCRIBER_MODEL=nvidia/parakeet-tdt-0.6b-v3
LIVE_TRANSCRIBER_MODEL=Systran/faster-whisper-large-v3
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1

# Tailscale HTTPS certificate paths. Generate these on dominus-nobara.
TRANSCRIPTION_MAGICDNS_FQDN=dominus-nobara.tail9bdca.ts.net
