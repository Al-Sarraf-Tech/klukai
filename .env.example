# Required: must match aichat's POSTGRES_PASSWORD
POSTGRES_PASSWORD=

# Klukai runs on cloud AI only (owner, 2026-10-26). The key powers everything:
# Sonnet 5.5 chat when KLUKAI_CLAUDE_PRIMARY=true, else Haiku 5.5; Haiku for
# all background work and memory recall. Without a key she cannot answer.
# Owner authorized this API spending exception on 2026-10-14.
KLUKAI_CLAUDE_PRIMARY=false
ANTHROPIC_API_KEY=

# Optional: scoped web/reference MCP tools. Empty config keeps legacy MCP_URL.
# See docs/handoff/2026-10-14-web-tools.md for host setup and credential pickup.
KLUKAI_MCP_CONFIG=
# Set to the private directory containing gateway.token; never commit that file.
# KLUKAI_MCP_SECRETS_DIR=/home/jalsarraf/.local/share/mcp-stack/klukai
# Klukai production: true under the owner's 2026-10-14 paid-Brave exception.
# Other deployments need their own no-charge confirmation or spending permission.
KLUKAI_BRAVE_ENABLED=false

# Prepared cloud creative providers; disabled until separately authorized.
# Interactive Sonnet permission does not authorize these background/image calls.
# Production owner-selected main renderer: agy, the account worker (Grok, then
# Codex, then Agy; included account quota). Setup:
# ops/amarillo/systemd/klukai-agy-images.service. Unset means agy.
KLUKAI_IMAGE_PROVIDER=agy
KLUKAI_CHAT_IMAGE_PROVIDER=
KLUKAI_AGY_ALLOWED_USERS=
# Background account pictures, allowlisted users only (owner order 2026-10-19:
# no Dominus image work). Missing Live Portrait bases drawn by the worker: at
# most this many new ones per local day (0 = off; the official portrait shows).
KLUKAI_PORTRAIT_DAILY_LIMIT=3
# Album seeding renders per run and per local day: 0 = off (default); never
# more than 2. Also needs klukai-memory-archive-seed.timer enabled (amarillo).
KLUKAI_ALBUM_SEED_RENDERS=0
# Private token + Unix socket only, never a Google credential directory.
# KLUKAI_AGY_RUNTIME_DIR=/home/jalsarraf/.local/share/klukai/agy-bridge/runtime
OPENAI_API_KEY=
KLUKAI_OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst-2026-09-08
KLUKAI_OPENAI_IMAGE_QUALITY=max
# JSON array of adopted character reference files inside the container.
KLUKAI_IMAGE_REFERENCE_FILES=[]
# haiku = dreams and Her POV writing on the background Haiku route;
# anthropic = capped Sonnet writing (the limits below). "local" is an old
# name for haiku.
KLUKAI_CREATIVE_TEXT_PROVIDER=haiku
# Persistent UTC attempt limits. All must be positive for their path to run.
# Failed/unknown outcomes count. These are attempt caps, NOT dollar caps.
KLUKAI_CLOUD_IMAGE_DAILY_LIMIT=0
KLUKAI_CLOUD_IMAGE_MONTHLY_LIMIT=0
KLUKAI_CLOUD_TEXT_DAILY_LIMIT=0
KLUKAI_CLOUD_TEXT_MONTHLY_LIMIT=0
KLUKAI_CREATIVE_LEDGER=/images/.creative/attempts.sqlite3

# Optional: VAPID keys for Web Push notifications
# Generate with: pip install py-vapid && vapid --gen
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

# Signing secrets for HMAC URL signing + audit-chain. OPTIONAL: if unset, the
# app generates a strong random secret per process (never a guessable default);
# set these for cross-restart stability (audit-chain continuity) + key
# separation. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SIGNED_URL_SECRET=
AUDIT_CHAIN_SECRET=

# Per-user login passwords (seed users). A user is skipped if its password is
# unset. Format: SEED_PASSWORD_<USERNAME-UPPERCASE>
# SEED_PASSWORD_JALSARRAF=

# CORS — comma-separated allowed origins (default: https://klukai.appnest.cc).
# Add http://localhost:8300 for local dev.
# KLUKAI_CORS_ORIGINS=https://klukai.appnest.cc

# Voice is Fish Audio only (cloud): KLUKAI_VOICE_ENABLED=true and a key.
# Speech stays on a free model (core refuses any model not ending in
# "-free") and plays when tapped; no voice letters. Transcription uses
# transcribe-1-pro, pay-as-you-go (owner authorized 2026-10-26).
# VOICE_ASYNC_JOBS=true
# FISH_API_KEY=
# KLUKAI_FISH_VOICE_ID=47fc35b7311944bc9fa238ed856de1f3
# KLUKAI_FISH_MODEL=s2.1-pro-free

# Personal mode: every user elite, quotas off (ADR-0017). Default: true.
# KLUKAI_PERSONAL_MODE=true

# OpenTelemetry collector (obs stack). Fail-soft if unset/unreachable.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://klukai-alloy:4317

# Optional: Voice model overrides
# PIPER_VOICE=en_US-amy-medium
# WHISPER_MODEL=base.en

# Homelab RabbitMQ bus (rabbitmq-ops on amarillo Tailscale IP). Used by
# companion-events-bridge to fan Redis companion:events onto homelab.events.
# Must match ~/git/rabbitmq-ops/.env RABBITMQ_PASSWORD.
RABBITMQ_PASSWORD=
RABBIT_HOST=100.111.198.19
RABBIT_USER=homelab
LOCAL_HOSTNAME=amarillo
